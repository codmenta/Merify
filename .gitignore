```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
node_modules/
venv/
.venv/

# Build artifacts
dist/
build/
target/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific caches
.mypy_cache/
.pytest_cache/
```